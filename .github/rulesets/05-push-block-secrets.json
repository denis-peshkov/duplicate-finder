{
  "name": "Block secrets and key material",
  "target": "push",
  "source_type": "Repository",
  "enforcement": "active",
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "**/.env",
          "**/.env.*",
          "**/http-client.private.env.json",
          "**/cross-identity-deploy-key",
          "**/cross-identity-deploy-key.pub",
          "**/*id_rsa*",
          "**/*id_ed25519*"
        ]
      }
    },
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          "*.pem",
          "*.pfx",
          "*.p12",
          "*.key"
        ]
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 10
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
